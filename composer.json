{
    "name": "ahmedibrahimyassindev/tamara-php-sdk",
    "description": "Unofficial, community-maintained PHP SDK for Tamara Buy Now Pay Later (BNPL), with optional Laravel integration",
    "type": "library",
    "keywords": [
        "tamara",
        "payment",
        "bnpl",
        "gateway",
        "saudi arabia",
        "uae",
        "fintech",
        "sdk",
        "laravel"
    ],
    "homepage": "https://github.com/ahmedibrahimyassindev/tamara-php-sdk",
    "license": "MIT",
    "authors": [
        {
            "name": "Ahmed Ibrahim Yassin",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=8.2",
        "ext-curl": "*",
        "ext-json": "*",
        "psr/log": "^1.0|^2.0|^3.0"
    },
    "autoload": {
        "psr-4": {
            "TamaraPhpSdk\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TamaraPhpSdk\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "TamaraPhpSdk\\Laravel\\TamaraServiceProvider"
            ],
            "aliases": {
                "TamaraPhpSdk": "TamaraPhpSdk\\Laravel\\Facades\\Tamara"
            }
        }
    },
    "scripts": {
        "test": "php tests/run_tests.php"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
